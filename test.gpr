project Test is

   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use ".";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ( "--no-loop-unrolling", "--no-inlining");
   end Prove;

end Test;
